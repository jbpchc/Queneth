# ─── Queneth API configuration ───────────────────────────────────────────
# Copy to backend/.env. Every value here is read by app/core/config.py.

# Runtime
ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Database (docker-compose overrides the host to `db` automatically)
DATABASE_URL=postgresql+asyncpg://queneth:queneth@localhost:5432/queneth
DATABASE_ECHO=false
TEST_DATABASE_URL=postgresql+asyncpg://queneth:queneth@localhost:5432/queneth_test

# CORS: comma-separated browser origins allowed to call the API with cookies
FRONTEND_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Auth (Phase 2) — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECURE=false              # true behind HTTPS
COOKIE_DOMAIN=                   # e.g. .example.com when API and site use different hosts
RATE_LIMIT_ENABLED=true

# Public base URL of this API (absolute links to locally stored uploads)
API_PUBLIC_URL=http://localhost:8000

# External integrations (docs/INTEGRATIONS.md): live | mock
INTEGRATIONS_MODE=mock
INTEGRATION_TIMEOUT_SECONDS=5
INTEGRATION_RETRIES=2
PSGC_BASE_URL=https://psgc.gitlab.io/api
PSGC_CACHE_DAYS=30
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=queneth
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@queneth.test
BREVO_SENDER_NAME=Queneth
EMAIL_MAX_ATTEMPTS=5
LOCAL_UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# Background jobs (email retries; escrow release and drops in later phases)
SCHEDULER_ENABLED=true
