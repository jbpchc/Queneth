# ─── Queneth frontend configuration ───────────────────────────────────────
# Copy to frontend/.env. The frontend only ever talks to the Python API.

# Browser-reachable API base (used by client components and the typed client)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Server-side API base (server components). Docker Compose sets this to http://api:8000/api/v1.
API_INTERNAL_URL=http://localhost:8000/api/v1
# Public site URL for metadata, Open Graph and sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1
